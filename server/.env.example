PORT=4000
# Required in production: long random string used to sign admin tokens
JWT_SECRET=change-me
# Password for the admin login (POST /api/auth/login)
ADMIN_PASSWORD=change-me
# Where the SQLite file lives
DATABASE_PATH=./data/portfolio.db
# Allowed browser origins, comma separated (dev server shown)
CORS_ORIGIN=http://localhost:5173
# Optional: email yourself when someone uses the contact form
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=alizeyaliiiii@gmail.com
